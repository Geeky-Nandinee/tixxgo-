# ==========================================
# TIXXGO Environment Variables Template
# Copy this to .env: cp .env.example .env
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=tixxgo_db

# Optional Redis Cache
REDIS_URL=redis://localhost:6379

# Tixxgo Pricing Engine Parameters (Task 2)
TIXXGO_SERVICE_FEE=299
TIXXGO_DEFAULT_PROMO_DISCOUNT=200

# Travel Supplier Network Settings
SUPPLIER_TIMEOUT_MS=4000
